{%- extends "base.njk" -%}
{%- set waMessage = whatsapp or ('Olá! Li o artigo “' + title + '” no site do Baobá e tenho uma dúvida.') -%}
{%- block head %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "description": {{ description | dump | safe }},
    "datePublished": "{{ page.date | isoDate }}",
    {%- if cover %}"image": "{{ cover }}",{% endif %}
    "author": { "@type": "Organization", "name": "Espaço Baobá" },
    "publisher": { "@type": "Organization", "name": "Espaço Baobá" }
  }
  </script>
{%- endblock %}
{%- block main %}
    <article class="post">
      <header class="post__head">
        <nav class="crumbs" aria-label="Você está em">
          <a href="/blog/">Blog</a> <span aria-hidden="true">›</span> <span>{{ category }}</span>
        </nav>
        <h1 class="post__title">{{ title }}</h1>
        <p class="post__lead">{{ description }}</p>
        <p class="post__meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | dataBR }}</time> · {{ content | readingTime }} min de leitura</p>
      </header>
      {%- if cover %}
      <figure class="post__cover">
        <img src="{{ cover }}" alt="{{ cover_alt or '' }}" width="1200" height="800" fetchpriority="high">
      </figure>
      {%- endif %}

      <div class="post__layout">
        <div class="prose">
          {{ content | safe }}
          {%- if category == 'Saúde' %}
          <p class="prose__note">Este texto é informativo e não substitui a avaliação do pediatra. Em caso de urgência, procure atendimento médico.</p>
          {%- endif %}
        </div>

        <aside class="ask" aria-labelledby="ask-titulo">
          <svg class="ask__leaf" viewBox="-2 -18 50 26" aria-hidden="true"><use href="#leaf"/></svg>
          <h2 id="ask-titulo">Ficou com alguma dúvida?</h2>
          <p>Fale com a equipe do Baobá pelo WhatsApp. A mensagem já vai com o nome deste artigo.</p>
          <a class="btn btn--wa" href="{{ waMessage | waLink(site.whatsapp) }}" target="_blank" rel="noopener">
            <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            Tirar dúvida no WhatsApp
          </a>
        </aside>
      </div>
    </article>

    {%- set others = collections.posts | exclude(page.url) | head(3) %}
    {%- if others.length %}
    <section class="more" aria-labelledby="more-titulo">
      <h2 id="more-titulo" class="h2">Leia também</h2>
      <ul class="cards" role="list">
        {%- for post in others %}
        {% include "card.njk" %}
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}
{%- endblock %}
